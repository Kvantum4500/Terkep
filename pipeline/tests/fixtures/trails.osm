<?xml version="1.0" encoding="UTF-8"?>
<!-- Szintetikus turistaút-részlet a tesztekhez (nem valós adat). -->
<osm version="0.6" generator="kézi">
  <node id="1" lat="47.700" lon="19.000" version="1"/>
  <node id="2" lat="47.710" lon="19.000" version="1"/>
  <node id="3" lat="47.720" lon="19.010" version="1"/>
  <node id="4" lat="47.730" lon="19.010" version="1"/>
  <node id="5" lat="47.700" lon="19.050" version="1"/>
  <node id="6" lat="47.705" lon="19.060" version="1"/>
  <!-- a kék sáv két útja; a második fordított irányú (az összefűzésnek kezelnie kell) -->
  <way id="10" version="1"><nd ref="1"/><nd ref="2"/><tag k="highway" v="path"/></way>
  <way id="11" version="1"><nd ref="4"/><nd ref="3"/><nd ref="2"/><tag k="highway" v="track"/></way>
  <way id="12" version="1"><nd ref="5"/><nd ref="6"/><tag k="highway" v="path"/></way>
  <relation id="100" version="1">
    <member type="way" ref="10" role=""/>
    <member type="way" ref="11" role=""/>
    <member type="way" ref="999" role=""/>
    <tag k="type" v="route"/>
    <tag k="route" v="hiking"/>
    <tag k="name" v="Próba kék sáv 1. szakasz"/>
    <tag k="jel" v="k"/>
    <tag k="network" v="nwn"/>
  </relation>
  <relation id="101" version="1">
    <member type="way" ref="12" role=""/>
    <tag k="type" v="route"/>
    <tag k="route" v="hiking"/>
    <tag k="name" v="Próba sárga kereszt"/>
    <tag k="osmc:symbol" v="yellow:white:yellow_cross"/>
    <tag k="network" v="lwn"/>
  </relation>
  <relation id="200" version="1">
    <member type="relation" ref="100" role=""/>
    <tag k="type" v="superroute"/>
    <tag k="route" v="hiking"/>
    <tag k="name" v="Próba Kéktúra"/>
    <tag k="jel" v="k"/>
  </relation>
  <!-- nem turistaút -->
  <relation id="300" version="1">
    <member type="way" ref="12" role=""/>
    <tag k="type" v="route"/>
    <tag k="route" v="bicycle"/>
    <tag k="name" v="Kerékpárút"/>
  </relation>
</osm>
